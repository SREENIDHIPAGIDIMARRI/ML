      "source": [
        "# ============================================================\n",
        "# 3. DOWNLOAD EXTERNAL GOOD IMAGES FROM KAGGLE\n",
        "#    Cracked & Intact Smartphone Images Dataset\n",
        "# ============================================================\n",
        "\n",
        "from pathlib import Path\n",
        "import os\n",
        "import shutil\n",
        "import zipfile\n",
        "\n",
        "GOOD_EXTRA_DIR = Path(\"/content/good_extra\")\n",
        "GOOD_EXTRA_DIR.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "# Kaggle dataset\n",
        "EXTERNAL_GOOD_DATASET = (\n",
        "    \"axondata/cracked-and-intact-smartphone-images-dataset\"\n",
        ")\n",
        "\n",
        "# Temporary download location\n",
        "EXTERNAL_DOWNLOAD_DIR = Path(\"/content/external_good_download\")\n",
        "EXTERNAL_DOWNLOAD_DIR.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "print(\"Downloading Cracked & Intact Smartphone dataset...\")\n",
        "\n",
        "!kaggle datasets download \\\n",
        "    -d axondata/cracked-and-intact-smartphone-images-dataset \\\n",
        "    -p /content/external_good_download \\\n",
        "    --unzip\n",
        "\n",
        "print(\"Download completed.\")\n",
        "\n",
        "# ============================================================\n",
        "# FIND WHOLE / INTACT FOLDER\n",
        "# ============================================================\n",
        "\n",
        "IMAGE_EXTENSIONS = {\n",
        "    \".jpg\", \".jpeg\", \".png\", \".bmp\",\n",
        "    \".tif\", \".tiff\", \".webp\"\n",
        "}\n",
        "\n",
        "possible_good_names = {\n",
        "    \"whole\",\n",
        "    \"intact\",\n",
        "    \"non_cracked\",\n",
        "    \"non-cracked\",\n",
        "    \"not_cracked\",\n",
        "    \"not-cracked\"\n",
        "}\n",
        "\n",
        "good_candidates = []\n",
        "\n",
        "for p in EXTERNAL_DOWNLOAD_DIR.rglob(\"*\"):\n",
        "\n",
        "    if p.is_dir() and p.name.lower() in possible_good_names:\n",
        "\n",
        "        image_count = sum(\n",
        "            1\n",
        "            for f in p.rglob(\"*\")\n",
        "            if f.is_file()\n",
        "            and f.suffix.lower() in IMAGE_EXTENSIONS\n",
        "        )\n",
        "\n",
        "        if image_count > 0:\n",
        "            good_candidates.append((p, image_count))\n",
        "\n",
        "\n",
        "print(\"\\nPossible Good/Intact folders:\")\n",
        "\n",
        "for folder, count in good_candidates:\n",
        "    print(f\"{folder}  →  {count} images\")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# SAFETY CHECK\n",
        "# ============================================================\n",
        "\n",
        "if len(good_candidates) == 0:\n",
        "\n",
        "    raise RuntimeError(\n",
        "        \"Could not automatically find a Whole/Intact folder. \"\n",
        "        \"Please inspect /content/external_good_download.\"\n",
        "    )\n",
        "\n",
        "# If there is exactly one candidate, use it automatically.\n",
        "if len(good_candidates) == 1:\n",
        "\n",
        "    external_good_source = good_candidates[0][0]\n",
        "\n",
        "else:\n",
        "\n",
        "    print(\"\\nMultiple candidates found.\")\n",
        "    print(\"Please inspect the folders above and select the correct one.\")\n",
        "\n",
        "    # Example:\n",
        "    # external_good_source = Path(\n",
        "    #     \"/content/external_good_download/Image_phones/Whole\"\n",
        "    # )\n",
        "\n",
        "    raise RuntimeError(\n",
        "        \"Multiple Good/Intact folders found. \"\n",
        "        \"Set 'external_good_source' manually.\"\n",
        "    )\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# COPY ONLY WHOLE / INTACT IMAGES\n",
        "# ============================================================\n",
        "\n",
        "extra_files = []\n",
        "\n",
        "for i, src in enumerate(\n",
        "    external_good_source.rglob(\"*\")\n",
        "):\n",
        "\n",
        "    if (\n",
        "        src.is_file()\n",
        "        and src.suffix.lower() in IMAGE_EXTENSIONS\n",
        "    ):\n",
        "\n",
        "        # Unique filename prevents collisions\n",
        "        new_name = (\n",
        "            f\"axon_whole_{i:05d}\"\n",
        "            f\"{src.suffix.lower()}\"\n",
        "        )\n",
        "\n",
        "        destination = GOOD_EXTRA_DIR / new_name\n",
        "\n",
        "        shutil.copy2(\n",
        "            src,\n",
        "            destination\n",
        "        )\n",
        "\n",
        "        extra_files.append(destination)\n",
        "\n",
        "\n",
        "print(\"\\n============================================================\")\n",
        "print(\"EXTERNAL GOOD IMAGE IMPORT COMPLETE\")\n",
        "print(\"============================================================\")\n",
        "\n",
        "print(\n",
        "    \"External Whole/Intact images added:\",\n",
        "    len(extra_files)\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Location:\",\n",
        "    GOOD_EXTRA_DIR\n",
        ")"
      ]
