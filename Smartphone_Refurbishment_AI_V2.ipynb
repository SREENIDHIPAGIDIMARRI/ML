      "cell_type": "code",
      "source": [
        "# ============================================================\n",
        "# EXTERNAL GOOD IMAGES\n",
        "# AxonData + Figshare\n",
        "# Everything goes into:\n",
        "# /content/good_extra\n",
        "# ============================================================\n",
        "\n",
        "from pathlib import Path\n",
        "import shutil\n",
        "import zipfile\n",
        "from google.colab import files\n",
        "\n",
        "IMAGE_EXTENSIONS = {\n",
        "    \".jpg\", \".jpeg\", \".png\",\n",
        "    \".bmp\", \".tif\", \".tiff\", \".webp\"\n",
        "}\n",
        "\n",
        "# ============================================================\n",
        "# COMMON DESTINATION\n",
        "# ============================================================\n",
        "\n",
        "GOOD_EXTRA_DIR = Path(\"/content/good_extra\")\n",
        "GOOD_EXTRA_DIR.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "# ============================================================\n",
        "# SOURCE 1 — AXONDATA\n",
        "# ============================================================\n",
        "\n",
        "AXON_DIR = Path(\"/content/axon_dataset\")\n",
        "AXON_DIR.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "print(\"Downloading AxonData...\")\n",
        "\n",
        "!kaggle datasets download \\\n",
        "    -d axondata/cracked-and-intact-smartphone-images-dataset \\\n",
        "    -p /content/axon_dataset \\\n",
        "    --unzip\n",
        "\n",
        "AXON_GOOD_SOURCE = AXON_DIR / \"Image_phones\"\n",
        "\n",
        "if not AXON_GOOD_SOURCE.exists():\n",
        "    raise FileNotFoundError(\n",
        "        f\"Image_phones not found at {AXON_GOOD_SOURCE}\"\n",
        "    )\n",
        "\n",
        "axon_count = 0\n",
        "\n",
        "for source in AXON_GOOD_SOURCE.iterdir():\n",
        "\n",
        "    if (\n",
        "        source.is_file()\n",
        "        and source.suffix.lower() in IMAGE_EXTENSIONS\n",
        "    ):\n",
        "\n",
        "        destination = (\n",
        "            GOOD_EXTRA_DIR /\n",
        "            f\"axon_good_{axon_count:05d}\"\n",
        "            f\"{source.suffix.lower()}\"\n",
        "        )\n",
        "\n",
        "        shutil.copy2(source, destination)\n",
        "        axon_count += 1\n",
        "\n",
        "print(f\"\\nAxonData Good images added: {axon_count}\")\n",
        "\n",
        "# Image_brokenphones is intentionally ignored.\n",
        "# 37 broken images -> NOT USED.\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# SOURCE 2 — FIGSHARE\n",
        "# ============================================================\n",
        "\n",
        "FIG_DIR = Path(\"/content/figshare_dataset\")\n",
        "FIG_DIR.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "FIG_ZIP = FIG_DIR / \"figshare_dataset.zip\"\n",
        "\n",
        "print(\"\\nUpload the Figshare ZIP file.\")\n",
        "print(\"Download it from:\")\n",
        "print(\"https://figshare.com/articles/dataset/\"\n",
        "      \"Data_Set_Smartphone_Screen_Damage_Detection_zip/29108471\")\n",
        "\n",
        "uploaded = files.upload()\n",
        "\n",
        "# Find the uploaded ZIP\n",
        "uploaded_zip = None\n",
        "\n",
        "for name, data in uploaded.items():\n",
        "\n",
        "    uploaded_path = FIG_DIR / name\n",
        "    uploaded_path.write_bytes(data)\n",
        "\n",
        "    if uploaded_path.suffix.lower() == \".zip\":\n",
        "        uploaded_zip = uploaded_path\n",
        "        break\n",
        "\n",
        "if uploaded_zip is None:\n",
        "    raise FileNotFoundError(\n",
        "        \"No Figshare ZIP file was uploaded.\"\n",
        "    )\n",
        "\n",
        "# ============================================================\n",
        "# EXTRACT FIGSHARE\n",
        "# ============================================================\n",
        "\n",
        "FIG_EXTRACTED = FIG_DIR / \"extracted\"\n",
        "\n",
        "if FIG_EXTRACTED.exists():\n",
        "    shutil.rmtree(FIG_EXTRACTED)\n",
        "\n",
        "FIG_EXTRACTED.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "with zipfile.ZipFile(uploaded_zip, \"r\") as z:\n",
        "    z.extractall(FIG_EXTRACTED)\n",
        "\n",
        "print(\"\\nFigshare extracted.\")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# FIND ONLY NOT_CRACKED\n",
        "# ============================================================\n",
        "\n",
        "FIG_GOOD_DIRS = []\n",
        "\n",
        "for folder in FIG_EXTRACTED.rglob(\"*\"):\n",
        "\n",
        "    if not folder.is_dir():\n",
        "        continue\n",
        "\n",
        "    if folder.name.lower() not in {\n",
        "        \"not_cracked\",\n",
        "        \"not-cracked\"\n",
        "    }:\n",
        "        continue\n",
        "\n",
        "    parts = [\n",
        "        p.lower()\n",
        "        for p in folder.parts\n",
        "    ]\n",
        "\n",
        "    # Must belong to train / valid / test\n",
        "    if any(\n",
        "        split in parts\n",
        "        for split in [\n",
        "            \"train\",\n",
        "            \"valid\",\n",
        "            \"validation\",\n",
        "            \"test\"\n",
        "        ]\n",
        "    ):\n",
        "        FIG_GOOD_DIRS.append(folder)\n",
        "\n",
