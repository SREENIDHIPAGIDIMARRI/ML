        "# ============================================================\n",
        "# 6. BALANCE ONLY THE TRAINING DATA\n",
        "# ============================================================\n",
        "# Oversample minority classes only inside TRAIN.\n",
        "# Validation and test remain untouched.\n",
        "\n",
        "max_train = train_df[\"class\"].value_counts().max()\n",
        "balanced_parts = []\n",
        "\n",
        "for cls in CLASSES:\n",
        "    part = train_df[train_df[\"class\"] == cls]\n",
        "    balanced_parts.append(\n",
        "        part.sample(\n",
        "            n=max_train,\n",
        "            replace=len(part) < max_train,\n",
        "            random_state=SEED\n",
        "        )\n",
        "    )\n",
        "\n",
        "balanced_train_df = (\n",
        "    pd.concat(balanced_parts)\n",
        "    .sample(frac=1, random_state=SEED)\n",
        "    .reset_index(drop=True)\n",
        ")\n",
        "\n",
        "print(\"Original training distribution:\")\n",
