      "source": [
        "# MVTec AD — Leakage-Safe PatchCore-Style Detector\n",
        "\n",
        "The original notebook used a **global EfficientNet embedding + StandardScaler + PCA + Mahalanobis distance**. It also selected a threshold from test-set information.\n",
        "\n",
        "For V2 we use a more local representation:\n",
        "\n",
        "**EfficientNet feature map → normal patch memory bank → nearest-neighbour patch distances → image anomaly score**\n",
        "\n",
        "The detector is built **separately for each MVTec category**, because bottle, cable, leather, etc. have different normal appearance distributions."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "641250ca",
      "metadata": {
        "id": "641250ca"
      },
      "outputs": [],
      "source": [
        "# ============================================================\n",
        "# 13. MVTec CATEGORY-WISE PATCH MEMORY BANK\n",
        "# ============================================================\n",
        "from sklearn.neighbors import NearestNeighbors\n",
        "\n",
        "MVTEC_IMG_SIZE = (224,224)\n",
        "\n",
        "mvtec_categories = sorted([\n",
        "    p.name for p in MVTEC_PATH.iterdir()\n",
        "    if p.is_dir()\n",
        "])\n",
        "\n",
        "print(\"Categories:\", mvtec_categories)\n",
        "\n",
        "mvtec_backbone = EfficientNetB0(\n",
        "    include_top=False,\n",
        "    weights=\"imagenet\",\n",
        "    input_shape=(*MVTEC_IMG_SIZE,3)\n",
        ")\n",
        "mvtec_backbone.trainable = False\n",
        "\n",
        "print(\"Feature map shape:\", mvtec_backbone.output_shape)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "d1996f42",
      "metadata": {
        "id": "d1996f42"
      },
      "outputs": [],
      "source": [
        "# ============================================================\n",
        "# 14. FEATURE EXTRACTION HELPERS\n",
        "# ============================================================\n",
        "def mvtec_feature_map(path):\n",
        "    img = tf.io.read_file(str(path))\n",
        "    img = tf.image.decode_image(img, channels=3, expand_animations=False)\n",
        "    img.set_shape([None,None,3])\n",
        "    img = tf.image.resize(img, MVTEC_IMG_SIZE)\n",
        "    img = tf.cast(img, tf.float32)\n",
        "    fmap = mvtec_backbone(tf.expand_dims(img,0), training=False)[0].numpy()\n",
        "    return fmap\n",
        "\n",
        "def normalize_patches(x, eps=1e-8):\n",
        "    x = np.asarray(x, dtype=np.float32)\n",
        "    return x / (np.linalg.norm(x, axis=1, keepdims=True) + eps)\n",
        "\n",
        "def list_images(folder):\n",
        "    return sorted([\n",
        "        p for p in Path(folder).iterdir()\n",
        "        if p.is_file() and p.suffix.lower() in IMAGE_EXTS\n",
        "    ])"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "fec5778c",
      "metadata": {
        "id": "fec5778c"
      },
      "outputs": [],
      "source": [
        "# ============================================================\n",
        "# 15. BUILD CATEGORY-WISE NORMAL PATCH BANKS\n",
        "# ============================================================\n",
        "MAX_PATCHES_PER_IMAGE = 49\n",
        "MAX_MEMORY_PATCHES = 3000\n",
        "\n",
        "memory_banks = {}\n",
        "val_thresholds = {}\n",
        "\n",
        "for category in mvtec_categories:\n",
        "    train_good_dir = MVTEC_PATH / category / \"train\" / \"good\"\n",
        "    train_good = list_images(train_good_dir)\n",
        "\n",
        "    if len(train_good) < 4:\n",
        "        print(\"Skipping\", category, \"- too few normal training images\")\n",
        "        continue\n",
        "\n",
        "    # Normal-only validation split. Test remains untouched.\n",
        "    rng = np.random.default_rng(SEED)\n",
        "    idx = np.arange(len(train_good))\n",
        "    rng.shuffle(idx)\n",
        "\n",
        "    n_val = max(2, int(0.15 * len(train_good)))\n",
        "    val_paths = [train_good[i] for i in idx[:n_val]]\n",
        "    fit_paths = [train_good[i] for i in idx[n_val:]]\n",
        "\n",
        "    patches = []\n",
        "\n",
        "    for p in fit_paths:\n",
        "        fmap = mvtec_feature_map(p)\n",
        "        h,w,c = fmap.shape\n",
        "        flat = fmap.reshape(-1,c)\n",
        "\n",
        "        # Deterministic patch subsampling if needed\n",
        "        if len(flat) > MAX_PATCHES_PER_IMAGE:\n",
        "            flat = flat[:MAX_PATCHES_PER_IMAGE]\n",
        "\n",
        "        patches.append(flat)\n",
        "\n",
        "    memory = normalize_patches(np.vstack(patches))\n",
        "\n",
        "    if len(memory) > MAX_MEMORY_PATCHES:\n",
        "        select = rng.choice(len(memory), MAX_MEMORY_PATCHES, replace=False)\n",
        "        memory = memory[select]\n",
        "\n",
        "    nn = NearestNeighbors(\n",
        "        n_neighbors=1,\n",
        "        metric=\"euclidean\",\n",
        "        algorithm=\"auto\"\n",
        "    )\n",
        "    nn.fit(memory)\n",
        "\n",
        "    # Score held-out normal validation images.\n",
        "    val_scores = []\n",
        "    for p in val_paths:\n",
        "        fmap = mvtec_feature_map(p)\n",
        "        patches_val = normalize_patches(fmap.reshape(-1, fmap.shape[-1]))\n",
        "        distances, _ = nn.kneighbors(patches_val)\n",
        "\n",
        "        # 95th percentile emphasizes localized abnormal patches\n",
        "        score = float(np.percentile(distances[:,0], 95))\n",
        "        val_scores.append(score)\n",
        "\n",
        "    # Conservative threshold based ONLY on normal validation data.\n",
        "    threshold = float(np.percentile(val_scores, 99.0))\n",
        "\n",
        "    memory_banks[category] = {\n",
        "        \"nn\": nn,\n",
        "        \"n_memory\": len(memory),\n",
        "        \"n_fit_images\": len(fit_paths),\n",
        "        \"n_val_images\": len(val_paths),\n",
        "        \"val_scores\": val_scores\n",
        "    }\n",
        "    val_thresholds[category] = threshold\n",
        "\n",
        "    print(\n",
        "        f\"{category:15s} | fit={len(fit_paths):3d} \"\n",
        "        f\"val={len(val_paths):2d} memory={len(memory):5d} \"\n",
        "        f\"threshold={threshold:.5f}\"\n",
        "    )\n",
        "\n",
        "print(\"\\n✅ Category-wise MVTec detectors built.\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "a619b946",
      "metadata": {
        "id": "a619b946"
      },
      "outputs": [],
      "source": [
        "# ============================================================\n",
        "# 16. MVTec IMAGE-LEVEL PREDICTOR\n",
        "# ============================================================\n",
        "def mvtec_score(category, image_path):\n",
        "    fmap = mvtec_feature_map(image_path)\n",
        "    patches = normalize_patches(fmap.reshape(-1, fmap.shape[-1]))\n",
        "\n",
        "    nn = memory_banks[category][\"nn\"]\n",
        "    distances, _ = nn.kneighbors(patches)\n",
        "\n",
        "    patch_distances = distances[:,0]\n",
        "\n",
        "    # Robust image-level anomaly score\n",
        "    score = float(np.percentile(patch_distances, 95))\n",
        "    return score\n",
        "\n",
        "def mvtec_predict(category, image_path):\n",
        "    score = mvtec_score(category, image_path)\n",
        "    threshold = val_thresholds[category]\n",
        "    return {\n",
        "        \"score\": score,\n",
        "        \"threshold\": threshold,\n",
        "        \"anomaly\": int(score >= threshold)\n",
        "    }\n",
        "\n",
        "print(\"MVTec predictor ready.\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "91bb4ff0",
      "metadata": {
        "id": "91bb4ff0"
      },
      "outputs": [],
      "source": [
        "# ============================================================\n",
        "# 17. FINAL MVTec TEST EVALUATION — TEST LABELS USED ONLY HERE\n",
        "# ============================================================\n",
        "from sklearn.metrics import (\n",
        "    accuracy_score, balanced_accuracy_score,\n",
        "    precision_score, recall_score, f1_score,\n",
        "    roc_auc_score, average_precision_score,\n",
        "    confusion_matrix\n",
        ")\n",
        "\n",
        "all_scores = []\n",
        "all_true = []\n",
        "all_pred = []\n",
        "all_categories = []\n",
        "\n",
        "for category in mvtec_categories:\n",
        "    if category not in memory_banks:\n",
        "        continue\n",
        "\n",
        "    test_root = MVTEC_PATH / category / \"test\"\n",
        "\n",
        "    for defect_dir in sorted([p for p in test_root.iterdir() if p.is_dir()]):\n",
        "        is_anomaly = 0 if defect_dir.name == \"good\" else 1\n",
        "\n",
        "        for p in list_images(defect_dir):\n",
        "            score = mvtec_score(category, p)\n",
        "            threshold = val_thresholds[category]\n",
        "            pred_label = int(score >= threshold)\n",
        "\n",
        "            all_scores.append(score)\n",
        "            all_true.append(is_anomaly)\n",
        "            all_pred.append(pred_label)\n",
        "            all_categories.append(category)\n",
        "\n",
        "all_true = np.asarray(all_true)\n",
        "all_pred = np.asarray(all_pred)\n",
        "all_scores = np.asarray(all_scores)\n",
        "\n",
        "print(\"================ MVTec V2 TEST ================\")\n",
        "print(\"Test images:\", len(all_true))\n",
        "print(f\"Accuracy          : {accuracy_score(all_true, all_pred)*100:.2f}%\")\n",
        "print(f\"Balanced Accuracy : {balanced_accuracy_score(all_true, all_pred)*100:.2f}%\")\n",
        "print(f\"Precision         : {precision_score(all_true, all_pred, zero_division=0)*100:.2f}%\")\n",
        "print(f\"Recall            : {recall_score(all_true, all_pred, zero_division=0)*100:.2f}%\")\n",
        "print(f\"F1                : {f1_score(all_true, all_pred, zero_division=0)*100:.2f}%\")\n",
        "print(f\"ROC-AUC           : {roc_auc_score(all_true, all_scores):.4f}\")\n",
        "print(f\"PR-AUC            : {average_precision_score(all_true, all_scores):.4f}\")\n",
        "print(\"===============================================\")\n",
        "\n",
        "print(\"\\nConfusion matrix:\")\n",
        "print(confusion_matrix(all_true, all_pred))"
      ]
    },
