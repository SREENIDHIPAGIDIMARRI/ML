        "# ============================================================\n",
        "# 4. BUILD MOBILE DATAFRAME + REMOVE EXACT DUPLICATES\n",
        "# ============================================================\n",
        "IMAGE_EXTS = {\".jpg\",\".jpeg\",\".png\",\".bmp\",\".tif\",\".tiff\"}\n",
        "CLASSES = [\"good\", \"oil\", \"scratch\", \"stain\"]\n",
        "\n",
        "def sha256_file(path, chunk=1024*1024):\n",
        "    h = hashlib.sha256()\n",
        "    with open(path, \"rb\") as f:\n",
        "        while True:\n",
        "            b = f.read(chunk)\n",
        "            if not b:\n",
        "                break\n",
        "            h.update(b)\n",
        "    return h.hexdigest()\n",
        "\n",
        "records = []\n",
        "\n",
        "# Original dataset\n",
        "for cls in CLASSES:\n",
        "    folder = MOBILE_PATH / cls\n",
        "    if folder.exists():\n",
        "        for p in folder.rglob(\"*\"):\n",
        "            if p.is_file() and p.suffix.lower() in IMAGE_EXTS:\n",
        "                records.append({\"image_path\": str(p), \"class\": cls, \"source\": \"original\"})\n",
        "\n",
        "# Additional genuine Good images\n",
        "for p in extra_files:\n",
        "    records.append({\"image_path\": str(p), \"class\": \"good\", \"source\": \"extra_good\"})\n",
        "\n",
        "mobile_df = pd.DataFrame(records)\n",
        "\n",
        "# Validate images and remove exact byte duplicates\n",
        "valid_rows = []\n",
        "bad = []\n",
        "seen_hashes = set()\n",
