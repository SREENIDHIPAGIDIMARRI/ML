      "source": [
        "# ============================================================\n",
        "# 18. MVTec CATEGORY-WISE RESULTS\n",
        "# ============================================================\n",
        "rows = []\n",
        "\n",
        "for category in sorted(set(all_categories)):\n",
        "    mask = np.array(all_categories) == category\n",
        "    y = all_true[mask]\n",
        "    p = all_pred[mask]\n",
        "    s = all_scores[mask]\n",
        "\n",
        "    row = {\n",
        "        \"category\": category,\n",
        "        \"n\": int(mask.sum()),\n",
        "        \"accuracy\": accuracy_score(y,p),\n",
        "        \"balanced_accuracy\": balanced_accuracy_score(y,p),\n",
        "        \"precision\": precision_score(y,p,zero_division=0),\n",
        "        \"recall\": recall_score(y,p,zero_division=0),\n",
        "        \"f1\": f1_score(y,p,zero_division=0),\n",
        "    }\n",
        "\n",
        "    # ROC-AUC requires both classes in that category.\n",
        "    row[\"roc_auc\"] = roc_auc_score(y,s) if len(np.unique(y)) == 2 else np.nan\n",
        "    rows.append(row)\n",
        "\n",
        "mvtec_results = pd.DataFrame(rows)\n",
        "display(mvtec_results)\n",
        "\n",
        "mvtec_results.to_csv(\"/content/mvtec_v2_category_results.csv\", index=False)\n",
        "print(\"Saved:\", \"/content/mvtec_v2_category_results.csv\")"
      ]
    },
